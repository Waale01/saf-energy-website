---
const blocks = [
  {
    tag: "Our Mission",
    title: "Dependable energy supply, without compromise",
    body: "To deliver petroleum products and energy logistics services with unmatched reliability, safety, and efficiency &mdash; keeping our clients' operations running without interruption.",
    icon: "target",
    reverse: false,
  },
  {
    tag: "Our Vision",
    title: "West Africa's most trusted energy partner",
    body: "To become a leading name in petroleum distribution and energy logistics, recognized for integrity, innovation, and the strength of long-term partnerships with the industries we serve.",
    icon: "compass",
    reverse: true,
  },
  {
    tag: "What We Do",
    title: "End-to-end petroleum supply and logistics",
    body: "From bulk procurement and storage to haulage and last-mile delivery, SAF Energy manages the full supply chain so businesses, retailers, and institutions get fuel where and when they need it.",
    icon: "route",
    reverse: false,
  },
];

const icons: Record<string, string> = {
  target:
    'M12 21a9 9 0 100-18 9 9 0 000 18zM12 17a5 5 0 100-10 5 5 0 000 10zM12 13a1 1 0 100-2 1 1 0 000 2z',
  compass:
    'M12 21a9 9 0 100-18 9 9 0 000 18zM15 9l-2.5 5.5L9 16.5 11.5 11 15 9z',
  route:
    'M6 19a2 2 0 100-4 2 2 0 000 4zM18 9a2 2 0 100-4 2 2 0 000 4zM8 17c4-1 6-3 8-6M6 15V9a2 2 0 012-2h2',
};
---

<section id="about" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-amber">About SAF Energy</span>
      <h2 class="mt-3 text-3xl font-extrabold text-petrol sm:text-4xl">Built for the demands of industry</h2>
    </div>

    <div class="mt-20 space-y-20">
      {
        blocks.map((block) => (
          <div class={`flex flex-col items-center gap-10 lg:gap-16 ${block.reverse ? "lg:flex-row-reverse" : "lg:flex-row"}`}>
            <div class="w-full lg:w-1/2">
              <div class="relative flex aspect-[4/3] w-full items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-br from-petrol to-petrol-dark">
                <div
                  class="absolute inset-0 opacity-10"
                  style="background-image: linear-gradient(rgba(255,255,255,0.8) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.8) 1px, transparent 1px); background-size: 32px 32px;"
                />
                <svg class="relative h-20 w-20 text-amber" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25">
                  <path stroke-linecap="round" stroke-linejoin="round" d={icons[block.icon]} />
                </svg>
              </div>
            </div>

            <div class="w-full lg:w-1/2">
              <span class="text-sm font-bold uppercase tracking-widest text-amber">{block.tag}</span>
              <h3 class="mt-3 text-2xl font-bold text-petrol sm:text-3xl">{block.title}</h3>
              <p class="mt-4 text-base leading-relaxed text-steel" set:html={block.body} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
