---
const blocks = [
  {
    tag: "Our Mission",
    title: "Keep the power on for the people who rely on you",
    body: "To supply fuel and power solutions that keep estates, banks and businesses running, delivered on schedule and backed by equipment that is properly installed and maintained.",
    image: "/images/about/mission.jpg",
    alt: "Two SAF Energy field staff in safety helmets and coveralls walking toward a refinery at sunset",
    reverse: false,
  },
  {
    tag: "Our Vision",
    title: "One trusted partner for fuel, backup power and solar",
    body: "To be the first call for estates, banks and businesses that want reliable power, and to help each client move from diesel-only supply to lower-cost solar-diesel hybrid and solar systems over time.",
    image: "/images/about/vision.jpg",
    alt: "Digital rendering of a next-generation petroleum processing and pipeline facility",
    reverse: true,
  },
  {
    tag: "What We Do",
    title: "Fuel, power equipment and solar, under one roof",
    body: "We deliver diesel, petrol, LPG and lubricants on scheduled or emergency runs, supply and service generators, changeovers, inverters and UPS, and provide solar and battery systems that cut diesel spend.",
    image: "/images/about/what-we-do.jpg",
    alt: "Aerial view of an offshore petroleum platform at sea",
    reverse: false,
  },
];
---

<section id="about" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-amber">About SAF Energy</span>
      <h2 class="mt-3 text-3xl font-extrabold text-petrol sm:text-4xl">Fuel and power you can rely on</h2>
    </div>

    <div class="mt-20 space-y-20">
      {
        blocks.map((block) => (
          <div class={`flex flex-col items-center gap-10 lg:gap-16 ${block.reverse ? "lg:flex-row-reverse" : "lg:flex-row"}`}>
            <div class="w-full lg:w-1/2">
              <div class="relative aspect-[4/3] w-full overflow-hidden rounded-2xl">
                <img
                  src={block.image}
                  alt={block.alt}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-petrol-dark/40 via-transparent to-transparent" />
              </div>
            </div>

            <div class="w-full lg:w-1/2">
              <span class="text-sm font-bold uppercase tracking-widest text-amber">{block.tag}</span>
              <h3 class="mt-3 text-2xl font-bold text-petrol sm:text-3xl">{block.title}</h3>
              <p class="mt-4 text-base leading-relaxed text-steel" set:html={block.body} />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
