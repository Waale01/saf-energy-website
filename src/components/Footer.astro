---
const year = new Date().getFullYear();

const quickLinks = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Products & Services" },
  { href: "#projects", label: "Projects" },
  { href: "#why-us", label: "Why Choose Us" },
  { href: "#contact", label: "Contact" },
];

const socialLinks = [
  { label: "LinkedIn", href: "#" },
  { label: "Facebook", href: "#" },
  { label: "Instagram", href: "#" },
];
---

<footer class="bg-charcoal text-white">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-3">
      <div>
        <a href="#top" class="inline-flex items-center rounded-md bg-white px-3 py-2">
          <img
            src="/logo/saf-energy-logo-petrol-blue.png"
            alt="SAF Energy Limited"
            class="h-8 w-auto"
          />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-steel-light">
          Petroleum products, bulk distribution, storage, and logistics, delivered with
          industrial-grade reliability.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-amber">Quick Links</h3>
        <ul class="mt-4 space-y-2.5">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-steel-light hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-bold uppercase tracking-widest text-amber">Follow Us</h3>
        <ul class="mt-4 space-y-2.5">
          {
            socialLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-steel-light hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-8 text-center text-xs text-steel-light">
      &copy; {year} SAF Energy Limited. All rights reserved.
    </div>
  </div>
</footer>
