---
const navLinks = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Products & Services" },
  { href: "#projects", label: "Projects" },
  { href: "#why-us", label: "Why Choose Us" },
  { href: "#contact", label: "Contact" },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-petrol/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="#top" class="flex items-center gap-2 text-white">
      <span class="relative inline-flex h-8 w-8 items-center justify-center rounded-full bg-amber">
        <span class="h-2.5 w-2.5 rounded-full bg-petrol"></span>
      </span>
      <span class="flex flex-col leading-none">
        <span class="text-lg font-extrabold tracking-wide">SAF</span>
        <span class="text-[10px] font-medium tracking-[0.2em] text-steel-light">ENERGY LIMITED</span>
      </span>
    </a>

    <nav class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm font-medium text-white/85 transition-colors hover:text-amber"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden lg:block">
      <a
        href="#contact"
        class="rounded-md bg-amber px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-amber-dark"
      >
        Request a Quote
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="inline-flex items-center justify-center rounded-md p-2 text-white lg:hidden"
    >
      <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-white/10 bg-petrol lg:hidden">
    <ul class="space-y-1 px-4 py-4">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md px-3 py-2.5 text-base font-medium text-white/90 hover:bg-white/5 hover:text-amber"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href="#contact"
          class="block rounded-md bg-amber px-3 py-2.5 text-center text-base font-semibold text-white hover:bg-amber-dark"
        >
          Request a Quote
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
    });
  });
</script>
