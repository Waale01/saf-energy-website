---
const projects = [
  {
    title: "Estates & Residential Communities",
    category: "Estates",
    body: "Scheduled diesel for estate generators, LPG supply and gas piping, and solar street lights for estate roads.",
  },
  {
    title: "Banks, Malls & Offices",
    category: "Banks & Offices",
    body: "Diesel supply, changeovers, inverters and UPS that keep branches and offices open through every outage.",
  },
  {
    title: "Hospitals, Hotels & Schools",
    category: "Care & Hospitality",
    body: "Reliable power for clinics, hotels and schools, with emergency refuelling and LPG for kitchens.",
  },
  {
    title: "Factories, Telecom & Logistics",
    category: "Industry",
    body: "Bulk diesel and storage tanks for factories and cold rooms, telecom sites, and petrol for logistics fleets.",
  },
];
---

<section id="projects" class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-amber">Who We Serve</span>
      <h2 class="mt-3 text-3xl font-extrabold text-petrol sm:text-4xl">Power for every kind of site</h2>
      <p class="mt-4 text-base leading-relaxed text-steel">
        Estates, banks and businesses that cannot afford to go dark. Project photos and client case
        studies coming soon.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        projects.map((project) => (
          <article class="text-center">
            <div class="relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-lg bg-gradient-to-br from-petrol-dark via-petrol to-charcoal">
              <div
                class="absolute inset-0 opacity-10"
                style="background-image: repeating-linear-gradient(135deg, rgba(255,255,255,0.6) 0 2px, transparent 2px 24px);"
              />
              <span class="relative rounded-full bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-amber backdrop-blur">
                {project.category}
              </span>
            </div>
            <h3 class="mt-4 font-serif text-lg font-bold text-petrol">{project.title}</h3>
            <p class="mt-2 font-serif text-sm leading-relaxed text-steel">{project.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
