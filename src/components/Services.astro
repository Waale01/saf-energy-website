---
const services = [
  {
    title: "Diesel (AGO) Supply",
    body: "Our core product. Diesel for generators at estates, banks, offices and plants, delivered to your tank.",
    icon: "M12 3l7 4v10l-7 4-7-4V7l7-4zM12 3v18",
  },
  {
    title: "Petrol (PMS) & LPG",
    body: "Petrol for fleets and smaller generators, and LPG (cooking gas) including bulk supply and gas piping for estates, hotels and restaurants.",
    icon: "M9 3h6l1 4h4v2h-2l-2 12H8L6 9H4V7h4l1-4zM9 12h6",
  },
  {
    title: "Lubricants & Consumables",
    body: "Engine oil, lubricants, coolants, additives and filters to keep generators and vehicles in good working order.",
    icon: "M12 2l1.5 4.5H18l-3.6 2.8 1.4 4.5-3.8-2.8-3.8 2.8 1.4-4.5L6 6.5h4.5L12 2z",
  },
  {
    title: "Scheduled & Emergency Delivery",
    body: "Weekly or monthly delivery contracts so you never run low, plus emergency refuelling during outages.",
    icon: "M3 16V7a1 1 0 011-1h9v10M3 16h13M3 16a2 2 0 104 0m9 0a2 2 0 104 0m-4 0h4m0 0v-4h3l2 3v1",
  },
  {
    title: "Storage Tanks & Fuel Monitoring",
    body: "Bulk storage tank supply and installation, with tank level sensors and consumption reports so you can see where your fuel goes.",
    icon: "M5 21V9l7-6 7 6v12M9 21v-6h6v6",
  },
  {
    title: "Generators & Maintenance",
    body: "Generator supply, installation and servicing, with maintenance contracts that keep your backup power ready.",
    icon: "M13 2L3 14h9l-1 8 10-12h-9l1-8z",
  },
  {
    title: "Changeovers, Inverters & UPS",
    body: "Automatic transfer switches and changeover systems, and inverters and UPS for banks and offices that cannot afford downtime.",
    icon: "M13 2L3 14h9l-1 8 10-12h-9l1-8z",
  },
  {
    title: "Solar & Hybrid Systems",
    body: "Solar panels, inverters and lithium batteries, solar-diesel hybrid systems that reduce diesel spend, and energy audits that show your power costs and potential savings.",
    icon: "M12 3v2m0 14v2m9-9h-2M5 12H3m15.4-6.4L17 7M7 17l-1.4 1.4m12.8 0L17 17M7 7L5.6 5.6M16 12a4 4 0 11-8 0 4 4 0 018 0z",
  },
  {
    title: "Solar Street Lights & Water Pumps",
    body: "Solar street lights for estates and roads, and solar water pumps and boreholes.",
    icon: "M12 3v2m0 14v2m9-9h-2M5 12H3m15.4-6.4L17 7M7 17l-1.4 1.4m12.8 0L17 17M7 7L5.6 5.6M16 12a4 4 0 11-8 0 4 4 0 018 0z",
  },
];
---

<section id="services" class="bg-offwhite py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-amber">Products &amp; Services</span>
      <h2 class="mt-3 text-3xl font-extrabold text-petrol sm:text-4xl">Fuel, power equipment and solar</h2>
      <p class="mt-4 text-base leading-relaxed text-steel">
        Everything your site needs to stay powered, from the diesel in your tank to the solar on your
        roof.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <div class="group rounded-xl border border-steel-light bg-white p-8 transition-shadow hover:shadow-xl hover:shadow-petrol/5">
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-petrol/5 text-petrol transition-colors group-hover:bg-amber group-hover:text-white">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
              </svg>
            </div>
            <h3 class="mt-5 text-lg font-bold text-petrol">{service.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel">{service.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
