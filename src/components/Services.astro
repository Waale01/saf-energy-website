---
const services = [
  {
    title: "Petroleum Products Supply",
    body: "Bulk supply of PMS, AGO, DPK, and other refined petroleum products to distributors, retailers, and industrial clients.",
    icon: "M12 3l7 4v10l-7 4-7-4V7l7-4zM12 3v18",
  },
  {
    title: "Bulk Fuel Distribution",
    body: "Scheduled and on-demand distribution to filling stations, depots, and commercial sites with tracked deliveries.",
    icon: "M4 16V7a2 2 0 012-2h6l4 4h4a2 2 0 012 2v5M4 16a2 2 0 002 2h1m-3-2h20m-3 0a2 2 0 11-4 0m4 0a2 2 0 11-4 0m-8 0a2 2 0 11-4 0m4 0a2 2 0 11-4 0",
  },
  {
    title: "Storage & Terminal Services",
    body: "Secure tank farm and terminal storage solutions with strict inventory control and safety monitoring.",
    icon: "M5 21V9l7-6 7 6v12M9 21v-6h6v6",
  },
  {
    title: "Haulage & Trucking",
    body: "A modern fleet of tankers and trucks for safe, on-time transport across state and regional routes.",
    icon: "M3 16V7a1 1 0 011-1h9v10M3 16h13M3 16a2 2 0 104 0m9 0a2 2 0 104 0m-4 0h4m0 0v-4h3l2 3v1",
  },
  {
    title: "Lubricants & Industrial Oils",
    body: "Quality-assured lubricants and industrial oils for automotive, marine, and heavy machinery applications.",
    icon: "M12 2l1.5 4.5H18l-3.6 2.8 1.4 4.5-3.8-2.8-3.8 2.8 1.4-4.5L6 6.5h4.5L12 2z",
  },
  {
    title: "Energy Consultancy",
    body: "Advisory support on procurement, supply chain optimization, and regulatory compliance for energy operations.",
    icon: "M9 3h6l1 4h4v2h-2l-2 12H8L6 9H4V7h4l1-4zM9 12h6",
  },
];
---

<section id="services" class="bg-offwhite py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-amber">Products &amp; Services</span>
      <h2 class="mt-3 text-3xl font-extrabold text-petrol sm:text-4xl">What we deliver</h2>
      <p class="mt-4 text-base leading-relaxed text-steel">
        A full suite of petroleum supply and logistics services, tailored to the scale and pace of your
        operations.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <div class="group rounded-xl border border-steel-light bg-white p-8 transition-shadow hover:shadow-xl hover:shadow-petrol/5">
            <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-petrol/5 text-petrol transition-colors group-hover:bg-amber group-hover:text-white">
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
              </svg>
            </div>
            <h3 class="mt-5 text-lg font-bold text-petrol">{service.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel">{service.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
