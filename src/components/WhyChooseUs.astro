---
const points = [
  {
    title: "Supply You Can Count On",
    body: "Weekly or monthly delivery contracts keep your tanks topped up, and emergency refuelling covers you during outages.",
    icon: "M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z",
  },
  {
    title: "Fuel and Power in One Place",
    body: "Diesel, LPG, generators, changeovers, inverters and solar from one supplier, so you deal with one team.",
    icon: "M9 12l2 2 4-4m5 2a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Lower Diesel Spend",
    body: "Energy audits show what your power really costs, and solar-diesel hybrid systems bring that cost down.",
    icon: "M4 21V9l8-6 8 6v12M9 21v-6h6v6",
  },
  {
    title: "Clear Fuel Reporting",
    body: "Tank level sensors and consumption reports show how much fuel you use and where it goes.",
    icon: "M3.6 9h16.8M3.6 15h16.8M11.5 3a17 17 0 000 18M12.5 3a17 17 0 010 18M12 21a9 9 0 100-18 9 9 0 000 18z",
  },
];
---

<section id="why-us" class="bg-petrol py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-amber">Why Choose Us</span>
      <h2 class="mt-3 text-3xl font-extrabold text-white sm:text-4xl">Power without the guesswork</h2>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        points.map((point) => (
          <div class="rounded-xl border border-white/10 bg-white/5 p-7">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-amber/15 text-amber">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d={point.icon} />
              </svg>
            </div>
            <h3 class="mt-5 text-base font-bold text-white">{point.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-steel-light">{point.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-16 grid grid-cols-2 gap-6 border-t border-white/10 pt-12 sm:grid-cols-4">
      <div class="text-center">
        <div class="text-3xl font-extrabold text-white">Weekly</div>
        <div class="mt-1 text-xs font-medium uppercase tracking-wide text-steel-light">Or Monthly Deliveries</div>
      </div>
      <div class="text-center">
        <div class="text-3xl font-extrabold text-white">On Call</div>
        <div class="mt-1 text-xs font-medium uppercase tracking-wide text-steel-light">Outage Refuelling</div>
      </div>
      <div class="text-center">
        <div class="text-3xl font-extrabold text-white">Hybrid</div>
        <div class="mt-1 text-xs font-medium uppercase tracking-wide text-steel-light">Solar-Diesel Systems</div>
      </div>
      <div class="text-center">
        <div class="text-3xl font-extrabold text-white">Abeokuta</div>
        <div class="mt-1 text-xs font-medium uppercase tracking-wide text-steel-light">Ogun State Office</div>
      </div>
    </div>
  </div>
</section>
