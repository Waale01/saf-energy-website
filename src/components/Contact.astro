---
const whatsappNumber = "2347016278378";
const whatsappMessage = encodeURIComponent("Hello SAF Energy, I'd like to request a quote.");
---

<section id="contact" class="bg-offwhite py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-bold uppercase tracking-widest text-amber">Get in Touch</span>
      <h2 class="mt-3 text-3xl font-extrabold text-petrol sm:text-4xl">Request a quote</h2>
      <p class="mt-4 text-base leading-relaxed text-steel">
        Tell us what you need and our team will respond with pricing and availability.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-10 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <form class="space-y-5 rounded-2xl border border-steel-light bg-white p-8" method="POST" action="https://formspree.io/f/REPLACE_WITH_FORM_ID">
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="mb-1.5 block text-sm font-semibold text-petrol">Full Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full rounded-md border border-steel-light px-4 py-2.5 text-sm text-charcoal focus:border-petrol focus:outline-none focus:ring-1 focus:ring-petrol"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-semibold text-petrol">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full rounded-md border border-steel-light px-4 py-2.5 text-sm text-charcoal focus:border-petrol focus:outline-none focus:ring-1 focus:ring-petrol"
              />
            </div>
          </div>

          <div>
            <label for="phone" class="mb-1.5 block text-sm font-semibold text-petrol">Phone Number</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full rounded-md border border-steel-light px-4 py-2.5 text-sm text-charcoal focus:border-petrol focus:outline-none focus:ring-1 focus:ring-petrol"
            />
          </div>

          <div>
            <label for="message" class="mb-1.5 block text-sm font-semibold text-petrol">What do you need?</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full rounded-md border border-steel-light px-4 py-2.5 text-sm text-charcoal focus:border-petrol focus:outline-none focus:ring-1 focus:ring-petrol"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-md bg-amber px-6 py-3.5 text-base font-semibold text-white transition-colors hover:bg-amber-dark sm:w-auto"
          >
            Send Request
          </button>
        </form>
      </div>

      <div class="lg:col-span-2">
        <div class="h-full space-y-6 rounded-2xl bg-petrol p-8 text-white">
          <div>
            <h3 class="text-sm font-bold uppercase tracking-widest text-amber">Chat on WhatsApp</h3>
            <a
              href={`https://wa.me/${whatsappNumber}?text=${whatsappMessage}`}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex items-center gap-2 rounded-md bg-white/10 px-4 py-2.5 text-sm font-semibold hover:bg-white/20"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5.1-1.3A10 10 0 1012 2zm0 18a8 8 0 01-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1112 20zm4.4-5.9c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.4c.1-.1.2-.3.2-.4.1-.2 0-.3 0-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9 0 1.1.8 2.2.9 2.4.1.2 1.6 2.5 4 3.4.6.2 1 .4 1.3.5.6.2 1.1.1 1.5.1.5-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1-.1-.1-.2-.1-.4-.2z"/></svg>
              Message us on WhatsApp
            </a>
          </div>

          <div class="border-t border-white/10 pt-6">
            <h3 class="text-sm font-bold uppercase tracking-widest text-amber">Phone &amp; Email</h3>
            <p class="mt-3 text-sm text-steel-light">+234 701 627 8378</p>
            <p class="mt-1 text-sm text-steel-light">safenergylmtd@gmail.com</p>
          </div>

          <div class="border-t border-white/10 pt-6">
            <h3 class="text-sm font-bold uppercase tracking-widest text-amber">Office</h3>
            <p class="mt-3 text-sm text-steel-light">Lafenwa, Abeokuta</p>
            <p class="mt-1 text-sm text-steel-light">Mon &ndash; Fri: 8:00 AM &ndash; 6:00 PM</p>
            <p class="mt-1 text-sm text-steel-light">Sat: 9:00 AM &ndash; 2:00 PM</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
